--- 

<div class:list={["content", className]} {...rest}>
    <slot />
</div>

<style define:vars={{ 
    linear_param, 
    ring_bg_param,
    darken_percent,
    darken_percent_hovered,
    padding,
    border_radius,
    initial_angle,
    rotate_amount,
    overflow
}}>

@property --angle {
    syntax: "<angle>";
    inherits: false;
    initial-value: 0deg;  
}
@property --lighten {
    syntax: "<percentage>";
    inherits: false;
    initial-value: 100%;
}
.content {
    --lighten: var(--darken_percent);
    border: 3px solid transparent;
    background: 
        linear-gradient(var(--linear_param)) padding-box, 
        conic-gradient(var(--ring_bg_param)) border-box;
    padding: var(--padding);
    border-radius: var(--border_radius);
    transition: --angle .5s ease, --lighten .35s ease-in-out;
    box-shadow: 4px 6px 12px rgba(0, 0, 0, 1);
    overflow: var(--overflow)
}
.content:hover {
    --angle: calc(var(--rotate_amount) + var(--initial_angle));
    --lighten: var(--darken_percent_hovered); 
}

</style>