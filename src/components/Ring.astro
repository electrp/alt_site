---
import type { restoreFocus } from 'astro/virtual-modules/transitions-swap-functions.js';
import Color, { type ColorInstance } from 'color';

interface RingContext {
    layer: number,
    id: number,
}

interface Props {
    border_color: string,
    // ring_context?: RingContext,
    fill_color?: string,
    padding?: string,
    border_radius?: string,
    initial_angle?: string,
    rotate_amount?: string,
    class?: string,
    layer?: number,
    clip?: boolean,
}

const { 
    border_color,
    // ring_context,
    fill_color = '#40343e',
    padding = "5px",
    border_radius = "10px",
    initial_angle = "0deg",
    rotate_amount = "80deg",
    layer = 1,
    clip = false,
    class: className, 
    ...rest
} = Astro.props;
 
const linear_param = Color(fill_color).darken(1-Math.exp(-.1*layer)).hex();
const angular_param = `from calc(var(--angle) + ${initial_angle}), ` + border_color;
const overflow = clip ? "hidden" : "visible";

/* let transition_name = `ring`
for (let i = 0; i < layer; ++i) {
    if (Astro.locals.ring_layers.length <= i) {
        Astro.locals.ring_layers.push(0)
    }
    transition_name += `_${Astro.locals.ring_layers[i]}`;
}
if (Astro.locals.ring_layers.length <= layer) {
    Astro.locals.ring_layers.push(0)
}
transition_name += `_${Astro.locals.ring_layers[layer]}`;
Astro.locals.ring_layers[layer] += 1;
 
 console.log(transition_name) */
--- 

<div class:list={["content", className]} {...rest}>
    <slot />
</div>

<style define:vars={{ 
    linear_param, 
    angular_param,
    padding,
    border_radius,
    initial_angle,
    rotate_amount,
    overflow
}}>

@property --angle {
    syntax: "<angle>";
    inherits: false;
    initial-value: 0deg;  
}
/* @property --inheriting_ring_fix {
    syntax: "<string>"
    inherits: true;
    initial-value: "!!!"
} */
.content {
    border: 3px solid transparent;
    background: 
        linear-gradient(var(--linear_param)) padding-box, 
        conic-gradient(var(--angular_param)) border-box;
    padding: var(--padding);
    border-radius: var(--border_radius);
    transition: --angle .5s ease;
    box-shadow: 4px 6px 12px rgba(0, 0, 0, 1);
    overflow: var(--overflow)
}
.content:hover {
    --angle: calc(var(--rotate_amount) + var(--initial_angle));
}

</style>