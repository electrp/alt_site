---
interface Props {
    border_color: string,
    fill_color: string,
    padding?: string,
    border_radius?: string
}

const { 
    border_color, 
    fill_color,
    padding = "5px",
    border_radius = "10px",
} = Astro.props;
--- 

<div class="content">
    <slot />
</div>

<style define:vars={{ 
    border_color, 
    fill_color,
    padding,
    border_radius,
}}>
.content {
    border: 3px solid transparent;
    background: 
        linear-gradient(var(--fill_color)) padding-box, 
        conic-gradient(var(--border_color)) border-box;
    width: fit-content;
    height: fit-content;
    padding: var(--padding);
    border-radius: var(--border_radius);
}
</style>