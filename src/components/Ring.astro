---
import type { restoreFocus } from 'astro/virtual-modules/transitions-swap-functions.js';
import Color, { type ColorInstance } from 'color';

interface RingContext {
    layer: number,
    id: number,
}

interface Props {
    border_colors: String[],
    fill_color?: string,
    padding?: string,
    border_radius?: string,
    initial_angle?: string,
    rotate_amount?: string,
    class?: string,
    layer?: number,
    clip?: boolean,
    border_color_fade?: number,
    border_color_fade_hovered?: number
}

const { 
    border_colors,
    // ring_context,
    fill_color = '#40343e',
    padding = "5px",
    border_radius = "10px",
    initial_angle = "0deg",
    rotate_amount = "80deg",
    layer = 1,
    clip = false,
    class: className, 
    border_color_fade = .7,
    border_color_fade_hovered = 1,
 
    ...rest
} = Astro.props;
 
const linear_param = Color(fill_color).darken(1-Math.exp(-.1*layer)).hex();

console.log(border_colors)
console.log(Astro.props)

// A darkening parameter gets mixed in and automated on hover
const darken_percent = (border_color_fade * 100).toString() + "%";
const darken_percent_hovered = (border_color_fade_hovered * 100).toString() + "%";
const ring_bg_param = `from calc(var(--angle) + ${initial_angle}), ` 
    + border_colors.map(str =>
        "color-mix(in srgb, " 
        + Color(str).alpha(border_color_fade).hex()
        + " var(--lighten), transparent)"
    ).join(", ");   

const overflow = clip ? "hidden" : "visible";

