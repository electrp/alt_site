---
import Color, { type ColorInstance } from 'color';

interface Props {
    border_color: string,
    fill_color?: string,
    padding?: string,
    border_radius?: string,
    initial_angle?: string,
    rotate_amount?: string,
    class?: string,
    layer?: number,
    clip?: boolean,
}

const { 
    border_color, 
    fill_color = '#40343e',
    padding = "5px",
    border_radius = "10px",
    initial_angle = "0deg",
    rotate_amount = "80deg",
    class: className, 
    layer = 1,
    clip = false,
} = Astro.props;

const linear_param = Color(fill_color).darken(1-Math.exp(-.1*layer)).hex();
const angular_param = `from calc(var(--angle) + ${initial_angle}), ` + border_color;
const overflow = clip ? "hidden" : "visible";
--- 

<div class:list={["content", className]}>
    <slot />
</div>

<style define:vars={{ 
    linear_param, 
    angular_param,
    padding,
    border_radius,
    initial_angle,
    rotate_amount,
    overflow
}}>

@property --angle {
    syntax: "<angle>";
    inherits: false;
    initial-value: 0deg;  
}
.content {
    border: 3px solid transparent;
    background: 
        linear-gradient(var(--linear_param)) padding-box, 
        conic-gradient(var(--angular_param)) border-box;
    /* width: fit-content; */
    /* height: fit-content; */
    padding: var(--padding);
    border-radius: var(--border_radius);
    transition: --angle .5s ease;
    box-shadow: 4px 6px 12px rgba(0, 0, 0, 1);
    overflow: var(--overflow)
}
.content:hover {
    --angle: calc(var(--rotate_amount) + var(--initial_angle));
}

</style>