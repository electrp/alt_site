---
import Ring from "./Ring.astro";

interface Props {
    url: string
}

const { 
    url
} = Astro.props;
--- 

<div class="header_button">
    <a href={url}>
        <Ring border_color="from -45deg, #726972, #EE72F1,#726972", fill_color='#40343e'>
            <slot/>
        </Ring>
    </a>
</div>

<style>
.header_button {
    padding: 10px;
}
</style>