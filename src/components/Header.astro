---
import Gifs from "./Gifs.astro";
import HeaderButton from "./HeaderButton.astro";
import Ring from "./Ring.astro";


export const pages = [ 
    // { name: "Home", path: "/" },
    // { name: "Projects", path: "/Projects/" },
    // { name: "About", path: "About" },
]

const props = Astro.props 
const homepage = Astro.url
---

<Ring border_color="#726972, #EE72F1,#726972", fill_color='#40343e', initial_angle="-45deg", rotate_amount="200deg", layer={0}, padding="0px", clip={true}>
  <div id="page-selector" class="page-selector">
    <a href="/" class="gifbox" style="padding-right: 3px;">
      <Gifs></Gifs>  
    </a>
    <!-- <div style="display: flex; width: auto; height: 100%; align-items: center;">
      <div>
        my name is william<br>
        welcome to my webpage<br>
        &lt-- click to go home
      </div>
    </div> -->
    <div class="button_container">
      <div class="button_column">
        <HeaderButton url="/", text="Home" />
        <HeaderButton url="/", text="Tags" />
      </div>
      <div class="button_column">
        <HeaderButton url="/about", text="About" />
        <HeaderButton url="/", text="Projects" />
      </div>
    </div>
    <div style="display: flex; width: auto; height:100%; align-items: center; margin-left: auto; padding-right: 5px">
  </div>
  </div>
</Ring>

<style>
.gifbox {
  
}

.button_container {
 display: flex; 
 flex-grow: 1; 
 flex-direction: row; 
 align-items: center; 
 justify-content: center;
}

.button_column {
  display: grid;
  gap: 3px;
  padding: 10px;
  width: 25%;
  max-width: 20rem;
  min-width: fit-content;
  height: fit-content;
}

.page-selector {
  width: 100%;
  height: 100px;
  /* margin: 0; */
  /* background-color: #0d0950; */
  color: #ffffff;
  display: flex;
  flex-direction: row;

  overflow-y: hidden;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

