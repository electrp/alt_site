---
interface Props {
  tag: any,
  clickable: boolean 
}

const { tag, clickable = true } = Astro.props
const color = tag.data.color;
const text_color = tag.data.text_color ? tag.data.text_color : "Black";
---

{clickable ? (
    <a href={"/tags/" + tag.id}> 
        <div class="tag">
            {tag.data.name}
        </div>
    </a> 
) : (
    <div class="tag">
        {tag.data.name}
    </div>
)}


<style define:vars={{ color, text_color }}>
.tag {
  border-radius: 7px;
  background-color: var(--color);
  color: var(--text_color);
  padding: 2px;
  margin: 2px;
  width: fit-content;
  height: fit-content;
  display: inline-block;
}
</style>