---
import { getCollection, getEntries } from 'astro:content';
import Color, { type ColorInstance } from 'color';

import Card from "./Card.astro"
import Ring from '../Ring.astro';
import Tag from '../Tag.astro';
import Project from '../Project.astro';

interface Props {
    tag_filter?: string;
    project_filter?: string;
}

function shuffle(array) {
    let currentIndex = array.length;

    while (currentIndex != 0) {
        let randomIndex = Math.floor(Math.random() * currentIndex);
        currentIndex--;

        [array[currentIndex], array[randomIndex]] = [
          array[randomIndex], array[currentIndex]];
    }
}

const { tag_filter = "", project_filter = "" } = Astro.props
const pages = await getEntries(await getCollection("pages"))
// shuffle(pages)
const tags = await getEntries(await getCollection("tags"))
const tag = tags.find(tag => tag.id == tag_filter);
const projects = await getEntries(await getCollection("projects"))
const project = projects.find(proj => proj.id == project_filter);

var color 
if(tag != undefined) {
    color = tag.data.color
} else if (project != undefined) {
    color = project.data.color
} else {
    color = "#40343e"
}
const border_color = Color(color).darken(.25).hex();
const background_color = project == undefined ? "#40343e" : Color("#40343e").mix(Color(project.data.color), .15).hex();
---

<Ring border_colors={[border_color]}, class="cardbox", transition:persist, transition:name="main_content">
    {tag != undefined &&
        <Ring border_colors={[color]}, fill_color='#40343e', class="tagtitle", layer={2}>
            Posts Tagged <Tag tag={tag}, clickable={false} />
        </Ring>
    }
    {project != undefined &&
        <Ring border_colors={[color]}, fill_color={background_color}, class="tagtitle", layer={2}>
            Project <Project project={project}, clickable={false} />
        </Ring>
    }
    <div class="cardlist">
    {pages.map((post) => {
        var tag_strings = post.data.tags.map(tag => tag.id)
        if (tag_filter != "" && !tag_strings.includes(tag_filter)) {
            return 
        } else if (project_filter != "" && post.data.project.id != project_filter) {
            return
        } else {
            return <Card page={post}/>
        }
    })}
    </div>
</Ring>

<style>
.cardbox {
   max-width: 700px;
   margin: 1rem auto; 
}
.tagtitle {
    text-align: center;
}
.cardlist {
  max-width: 700px;
  margin: 1rem auto;

  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
  grid-gap: 20px;
}
</style>