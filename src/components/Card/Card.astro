---
import { getCollection } from 'astro:content'
import { getEntries } from 'astro:content'
import Tag from '../Tag.astro'
import Ring from '../Ring.astro'


interface Props {
  page: any
  tag_clickable?: boolean
  layer?: number
}

const { 
  page, 
  tag_clickable = true,
  layer = 2,
} = Astro.props
const tags = await getEntries(page.data.tags)

var colors_arr = tags.map(tag => tag.data.color);
colors_arr.push(colors_arr[0]);
const colors = colors_arr.join(", ")

---

<Ring border_color={colors}, class="card", layer={layer}>
  <article class="card">
    <!-- title -->
    <a class="card_link" href={"/page/" + page.id}>
      <header>{page.data.title}</header>
    </a>
    <!-- tags -->
    <div class="tags">
    {
      tags.map(tag => (
        <Tag tag={tag} clickable={tag_clickable} />
      ))
    }
    </div>
    { /* Hero images/video */}
    {/* project */}
    <p>{page.data.project}</p>
  </article>  
</Ring>

<style>
  .card {

  display: grid;
  grid-template-rows: max-content 200px 1fr;
  width: auto;
  height: auto;
}

.tags {
  flex-direction: row;
  flex: auto;
}

.card_link {
  content: "";
  position: relative;
  top: 0px;
  right: 0px;
  bottom: 0px;
  left: 0px;
}
</style>