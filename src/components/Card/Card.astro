---
import { getCollection } from 'astro:content'
import { getEntries } from 'astro:content'
import Tag from '../Tag.astro'
import Ring from '../Ring.astro'
import Project from '../Project.astro'
import { getEntry } from 'astro:content'
import Color, { type ColorInstance } from 'color';



interface Props {
  page: any
  tag_clickable?: boolean
  layer?: number,
  selected?: boolean
}

const { 
  page, 
  tag_clickable = true,
  layer = 2,
  selected = false,
} = Astro.props
const tags = await getEntries(page.data.tags)
const project = await getEntry(page.data.project)

var colors_arr = tags.map(tag => tag.data.color);
colors_arr.push(colors_arr[0]);

const name = page.data.title;

const background_color = project == undefined ? "#40343e" : Color("#40343e").mix(Color(project.data.color), .35).hex();
---

<Ring border_colors={colors_arr}, border_color_fade={selected ? 1 : .15}, fill_color={background_color}, class="card", layer={layer}, transition:persist, transition:name={name}>

  <article class="card">
    {
      project && 
        <Project project={project}, clickable={true}>

        </Project>
    }
    <!-- title -->
    <a class="card_link" href={"/page/" + page.id}>
      <h3>{page.data.title}</h3>
    </a>
    <!-- tags -->
    <div class="tags">
    {
      tags.map(tag => (
        <Tag tag={tag} clickable={tag_clickable} />
      ))
    }
    </div>
    
    { /* Hero images/video */}
    {/* project */}
    <!-- <p>{page.data.project}</p> -->
  </article>  
</Ring>

<style>

h3 {
  margin: 2px;
}

.card {

  display: grid;
  /* grid-template-rows: max-content 10px 1fr; */
  width: auto;
  height: auto;
  flow: row;
}

.tags {
  flex-direction: row;
  flex: auto;
  /* height: auto; */
}

.card_link {
  content: "";
  position: relative;
  top: 0px;
  right: 0px;
  bottom: 0px;
  left: 0px;
}
</style>