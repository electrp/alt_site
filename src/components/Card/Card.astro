---
import { getCollection } from 'astro:content'
import { getEntries } from 'astro:content'
import Tag from '../Tag.astro'


interface Props {
  page: any
  tag_clickable?: boolean
}

const { page, tag_clickable = true } = Astro.props
const tags = await getEntries(page.data.tags)
---

<article class="card">
  <!-- title -->
  <a class="card_link" href={"/page/" + page.id}>
    <header>{page.data.title}</header>
  </a>
  <!-- tags -->
  <div class="tags">
  {
    tags.map(tag => (
      <Tag tag={tag} clickable={tag_clickable} />
    ))
  }
  </div>
  { /* Hero images/video */}
  {/* project */}
  <p>{page.data.project}</p>
</article>

<style>
  .card {
  border: 1px solid #999999;
  border-radius: 3px;

  display: grid;
  grid-template-rows: max-content 200px 1fr;
  transition: transform 0.3s ease-in-out; 
}

.tags {
  flex-direction: row;
  flex: auto;
}

.card:hover {
  transform: scale(1.1)
}

.card_link {
  content: "";
  position: relative;
  top: 0px;
  right: 0px;
  bottom: 0px;
  left: 0px;
}
</style>